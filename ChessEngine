    "# Helper function for Playing Games\n",
    "def play_game(model1, model2, debug=False) -> list:\n",
    "    \"\"\"\n",
    "    params:\n",
    "        model1: Pytorch neural network, this is the model that should be trained\n",
    "        model2: Pytorch neural network, this model is just opponent\n",
    "    returns:\n",
    "        outcome: 1 if model1 win -1 if model1 lost\n",
    "        action_states: list of tuples in the form (action, state) where action is the action taken by\n",
    "        model1 in the given board state \"state\". action: 1 x 4672 tensor, state: 12 x 8 x 8 tensor\n",
    "    \"\"\"\n",
    "    model1_colour = random.choice([chess.WHITE, chess.BLACK])\n",
    "    action_states = []\n",
    "    outcome = None\n",
    "    game = Game(model1, model2, model1_colour, debug)\n",
    "    while not game.board.is_game_over():\n",
    "        action_states.append(game.make_move())\n",
    "    outcome = game.board.result()\n",
    "    outcome_map = {\n",
    "        \"1-0\": chess.WHITE,\n",
    "        \"0-1\": chess.BLACK,\n",
    "        \"1/2-1/2\": \"draw\"\n",
    "    }\n",
    "    winner = outcome_map[outcome]\n",
    "    if winner != \"draw\":\n",
    "        outcome = 1 if winner == model1_colour else -1\n",
    "    else:\n",
    "        outcome = -0.5\n",
    "\n",
    "    return outcome, action_states\n",
    "    "
