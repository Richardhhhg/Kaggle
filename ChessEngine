    "# Policy NN\n",
    "class ConvolutionBlock(nn.Module):\n",
    "    def __init__(self):\n",
    "        super(ConvolutionBlock, self).__init__()\n",
    "        self.conv1 = nn.Conv2d(12, 24, 2, stride=1)\n",
    "        self.bn1 = nn.BatchNorm2d(24)\n",
    "\n",
    "    def forward(self, x):\n",
    "        \"\"\"\n",
    "        Expects x of shape (batch_size, 12, 8, 8)\n",
    "        Returns tensor of shape (batch_size, 24, 7, 7)\n",
    "        \"\"\"\n",
    "        x = x.view(-1, 12, 8, 8) # batch x channel x rank x file, batch x 12 x 8 x 8\n",
    "        x = F.relu(self.bn1(self.conv1(x))) # batch x 24 x 7 x 7\n",
    "        return x\n",
    "\n",
    "class OutputBlock(nn.Module):\n",
    "    def __init__(self):\n",
    "        super(OutputBlock, self).__init__()\n",
    "        self.conv1 = nn.Conv2d(24, 1, 2, stride=1)\n",
    "        self.bn1 = nn.BatchNorm2d(1)\n",
    "        self.fc1 = nn.Linear(36, 256)\n",
    "        self.fc = nn.Linear(256, 8*8*73)\n",
    "    \n",
    "    def forward(self, x):\n",
    "        \"\"\"\n",
    "        Expects x of shape (batch_size, 24, 7, 7)\n",
    "        Returns logits of shape (batch, 8*8*73) = (batch, 4672)\n",
    "        \"\"\"\n",
    "        x = F.relu(self.bn1(self.conv1(x))) # (batch, 6, 6)\n",
    "        x = x.view(-1, 36) # (batch, 36)\n",
    "        x = F.relu(self.fc1(x)) # (batch, 256)\n",
    "        logits = self.fc(x) # (batch, 4672)\n",
    "        return logits\n",
    "\n",
    "class PolicyNN(nn.Module):\n",
    "    def __init__(self):\n",
    "        super(PolicyNN, self).__init__()\n",
    "        self.ConvBlock = ConvolutionBlock()\n",
    "        self.OutputBlock = OutputBlock()\n",
    "\n",
    "    def forward(self, x):\n",
    "        x = self.ConvBlock(x) # (batch x 24 x 7 x7)\n",
