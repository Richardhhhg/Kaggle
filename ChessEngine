    "# Training Loop\n",
    "def supervised_train(policy_net, criterion, dataloader_train, dataloader_val):\n",
    "    torch.manual_seed(seed)\n",
    "    device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "    policy_net.train()\n",
    "    optimizer = optim.Adam(policy_net.parameters(), lr=LEARNING_RATE)\n",
    "    train_losses = []\n",
    "    train_accuracies = []\n",
    "    val_losses = []\n",
    "    val_accuracies = []\n",
    "\n",
    "    for epoch in tqdm(range(EPOCHS)):\n",
    "        train_loss, train_correct, train_total = 0, 0, 0\n",
    "        policy_net.train()\n",
    "\n",
    "        for boards, moves, masks in dataloader_train:\n",
    "            boards = boards.to(device)\n",
    "            moves = moves.to(device)\n",
    "            masks = masks.to(device)\n",
    "    \n",
    "            optimizer.zero_grad()\n",
    "            logits = policy_net(boards)\n",
    "            logits = mask_illegal_moves(logits, masks)\n",
    "            loss = criterion(logits, moves)\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "    \n",
    "            train_loss += loss.item() * boards.size(0)\n",
    "            preds = logits.argmax(dim=1)\n",
    "            train_correct += (preds == moves).sum().item()\n",
    "            train_total += boards.size(0)\n",
    "    \n",
    "        train_loss /= train_total\n",
    "        train_acc = train_correct / train_total\n",
    "    \n",
    "        # -------- VALIDATION --------\n",
    "        val_loss, val_correct, val_total = 0, 0, 0\n",
    "        policy_net.eval()\n",
    "    \n",
    "        with torch.no_grad():\n",
    "            for boards, moves, masks in dataloader_val:\n",
    "                boards = boards.to(device)\n",
    "                moves = moves.to(device)\n",
    "                masks = masks.to(device)\n",
    "    \n",
    "                logits = policy_net(boards)\n",
    "                logits = mask_illegal_moves(logits, masks)\n",
    "                loss = criterion(logits, moves)\n",
    "    \n",
    "                val_loss += loss.item() * boards.size(0)\n",
    "                preds = logits.argmax(dim=1)\n",
    "                val_correct += (preds == moves).sum().item()\n",
    "                val_total += boards.size(0)\n",
    "\n",
    "        val_loss /= val_total\n",
    "        val_acc = val_correct / val_total\n",
    "    \n",
    "        print(\n",
    "            f\"Epoch {epoch:02d} | \"\n",
    "            f\"Train Loss: {train_loss:.4f}, Train Acc: {train_acc:.3f} | \"\n",
    "            f\"Val Loss: {val_loss:.4f}, Val Acc: {val_acc:.3f}\"\n",
    "        )\n",
    "\n",
    "        train_losses.append(train_loss)\n",
    "        train_accuracies.append(train_acc)\n",
    "        val_losses.append(val_loss)\n",
    "        val_accuracies.append(val_acc)\n",
    "\n",
    "    return train_losses, train_accuracies, val_losses, val_accuracies"
