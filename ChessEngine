(logits, moves)\n            loss.backward()\n            optimizer.step()\n    \n            train_loss += loss.item() * boards.size(0)\n            preds = logits.argmax(dim=1)\n            train_correct += (preds == moves).sum().item()\n            train_total += boards.size(0)\n    \n        train_loss /= train_total\n        train_acc = train_correct / train_total\n    \n        # -------- VALIDATION --------\n        val_loss, val_correct, val_total = 0, 0, 0\n        policy_net.eval()\n    \n        with torch.no_grad():\n            for boards, moves, masks in dataloader_val:\n                boards = boards.to(device)\n                moves = moves.to(device)\n                masks = masks.to(device)\n    \n                logits = policy_net(boards)\n                logits = mask_illegal_moves(logits, masks)\n                loss = criterion(logits, moves)\n    \n                val_loss += loss.item() * boards.size(0)\n                preds = logits.argmax(dim=1)\n                val_correct += (preds == moves).sum().item()\n                val_total += boards.size(0)\n\n        val_loss /= val_total\n        val_acc = val_correct / val_total\n    \n        print(\n            f\"Epoch {epoch:02d} | \"\n            f\"Train Loss: {train_loss:.4f}, Train Acc: {train_acc:.3f} | \"\n            f\"Val Loss: {val_loss:.4f}, Val Acc: {val_acc:.3f}\"\n        )\n\n        train_losses.append(train_loss)\n        train_accuracies.append(train_acc)\n        val_losses.append(val_loss)\n        val_accuracies.append(val_acc)\n\n    return train_losses, train_accuracies, val_losses, val_accuracies","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-28T18:09:09.609421Z","iopub.execute_input":"2025-12-28T18:09:09.609771Z","iopub.status.idle":"2025-12-28T18:09:09.621157Z","shell.execute_reply.started":"2025-12-28T18:09:09.609737Z","shell.execute_reply":"2025-12-28T18:09:09.620254Z"}},"outputs":[],"execution_count":56},{"cell_type":"code","source":"# 