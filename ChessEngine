    "\n",
    "def board_to_tensor(board):\n",
    "    tensor = torch.zeros((12, 8, 8), dtype=torch.float32)\n",
    "    piece_map = board.piece_map()\n",
    "\n",
    "    for square, piece in piece_map.items():\n",
    "        plane = piece.piece_type - 1\n",
    "        if piece.color == chess.BLACK:\n",
    "            plane += 6\n",
    "        row = 7 - chess.square_rank(square)\n",
    "        col = chess.square_file(square)\n",
    "        tensor[plane, row, col] = 1\n",
    "    return tensor\n",
    "\n",
    "def board_to_tensor_row(row):\n",
    "    board = row[\"Board\"]\n",
    "    return board_to_tensor(board)\n",
    "\n",
    "board_df = board_df.progress_apply(board_to_fen, axis=1)\n",
    "board_df[\"BoardTensor\"] = board_df.progress_apply(board_to_tensor_row, axis=1)"
   ]
