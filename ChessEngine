    "# Reinforcment Learning Training Loop\n",
    "def reinforcement_learning(model, epochs):\n",
    "    opponents = []\n",
    "    optimizer = optim.Adam(model.parameters(), lr=LEARNING_RATE)\n",
    "    losses = []\n",
    "    opponents.append(copy.deepcopy(model))\n",
    "    criterion = nn.CrossEntropyLoss()\n",
    "    for epoch in range(epochs):\n",
    "        if epoch % 100 == 0:\n",
    "            print(f\"EPOCH: {epoch + 1}\")\n",
    "\n",
    "        model.eval()\n",
    "        outcome, action_states = play_game(model, random.choice(opponents))\n",
    "        opponents.append(copy.deepcopy(model))\n",
    "        opponents = opponents[-10:]\n",
    "\n",
    "        model.train()\n",
    "        actions, states = zip(*action_states)\n",
    "        states = torch.stack(states)\n",
    "        actions = torch.stack(actions)\n",
    "        outcome = torch.tensor(outcome, dtype=torch.float32)\n",
    "    \n",
    "        logits = model(states)\n",
    "        # action_probs = logits.gather(1, actions.unsqueeze(1)).squeeze()\n",
    "        loss = criterion(logits, actions) * outcome\n",
    "\n",
    "        optimizer.zero_grad()\n",
