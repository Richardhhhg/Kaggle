    "# Converting Moves into Board States\n",
    "# TODO: This only runs one batch of games, later expand this\n",
    "def make_boards(row):\n",
    "    moves_text = row[\"movetext\"]\n",
    "    pgn = io.StringIO(moves_text)\n",
    "    game = chess.pgn.read_game(pgn)\n",
    "    board = game.board()\n",
    "    temp = []\n",
    "    for move in game.mainline_moves():\n",
    "        colour = board.turn\n",
    "        temp.append({\n",
    "            \"Result\": row[\"Result\"],\n",
    "            \"Board\": board.copy(),\n",
    "            \"Move\": move.uci(),\n",
    "            \"Colour\": colour\n",
    "        })\n",
    "        board.push(move)\n",
    "    return temp\n",
    "\n",
    "boards_list = lichess_data[:GAME_BATCH+1].progress_apply(make_boards, axis=1)\n",
    "boards_list_flat = []\n",
    "for sublist in tqdm(boards_list, desc=\"Flattening board states\"):\n",
    "    boards_list_flat.extend(sublist)\n",
    "board_df = pd.DataFrame(boards_list_flat)"
   ]
