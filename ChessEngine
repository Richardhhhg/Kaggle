ce":"from torch import nn\nfrom torch import optim\nimport torch.nn.functional as F\nfrom torch.utils.data import random_split, DataLoader, Dataset","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-28T17:52:50.144359Z","iopub.execute_input":"2025-12-28T17:52:50.144667Z","iopub.status.idle":"2025-12-28T17:52:50.162691Z","shell.execute_reply.started":"2025-12-28T17:52:50.144641Z","shell.execute_reply":"2025-12-28T17:52:50.161563Z"}},"outputs":[],"execution_count":31},{"cell_type":"code","source":"# Torch Dataset for Policy\nclass PolicyData(Dataset):\n    def __init__(self, board_states, move_labels, legal_moves):\n        \"\"\"\n        Args:\n            board_states: tensor representation of the board\n            move_labels: index of move\n            legal_moves: mask for the legal moves in the board state\n        \"\"\"\n        self.board_states = board_states\n        self.move_labels = move_labels\n        self.legal_moves = legal_moves\n\n    def __len__(self):\n        return len(self.board_states)\n\n    def __getitem__(self, idx):\n        return self.board_states[idx], self.move_labels[idx], self.legal_moves[idx]","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-28T17:52:50.165765Z","iopub.execute_input":"2025-12-28T17:52:50.166144Z","iopub.status.idle":"2025-12-28T17:52:50.181951Z","shell.execute_reply.started":"2025-12-28T17:52:50.166102Z","shell.execute_reply":"2025-12-28T17:52:50.180987Z"}},"outputs":[],"execution_count":32},{"cell_type":"code","source":"# Policy NN\nclass ConvolutionBlock(nn.Module):\n    def __init__(self):\n        super(ConvolutionBlock, self).__init__()\n        self.conv1 = nn.Conv2d(12, 24, 2, stride=1)\n        self.bn1 = nn.BatchNorm2d(24)\n\n    def forward(self, x):\n        \"\"\"\n        Expects x of shape (batch_size, 12, 8, 8)\n        Returns tensor of shape (batch_size, 24, 7, 7)\n        \"\"\"\n        x = x.view(-1, 12, 8, 8) # batch x channel x rank x file, batch x 12 x 8 x 8\n        x = F.relu(self.bn1(self.conv1(x))) # batch x 24 x 7 x 7\n        return x\n\nclass OutputBlock(nn.Module):\n    def __init__(self):\n        super(OutputBlock, self).__init__()\n        self.conv1 = nn.Conv2d(24, 1, 2, stride=1)\n        self.bn1 = nn.BatchNorm2d(1)\n        self.fc1 = nn.Linear(36, 256)\n        self.fc = nn.Linear(256, 8*8*73)\n    \n    def forward(self, x):\n        \"\"\"\n        Expects x of shape (batch_size, 24, 7, 7)\n        Returns logits of shape (batch, 8*8*73) = (batch, 4672)\n        \"\"\"\n        x = F.relu(self.bn1(self.conv1(x))) # (batch, 6, 6)\n        x = x.view(-1, 36) # (batch, 36)\n        x = F.relu(self.fc1(x)) # (batch, 256)\n        logits = self.fc(x) # (batch, 4672)\n        return logits\n\nclass PolicyNN(nn.Module):\n    def __init__(self):\n        super(PolicyNN, self).__init__()\n        self.ConvBlock = ConvolutionBlock()\n        self.OutputBlock = OutputBlock()\n\n    def forward(self, x):\n        x = self.ConvBlock(x) # (batch x 24 x 7 x7)\n        logits = self.OutputBlock(x) # (batch, 4672)\n        return logits\n        ","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-28T17:53:53.516597Z","iopub.execute_input":"2025-12-28T17:53:53.516962Z","iopub.status.idle":"2025-12-28T17:53:53.526737Z","shell.execute_reply.started":"2025-12-28T17:53:53.516931Z","shell.execute_reply":"2025-12-28T17:53:53.525845Z"}},"outputs":[],"execution_count":39},{"cell_type":"code","source":"# Illegal Move Mask\ndef mask_illegal_moves(logits, masks):\n    \"\"\"\n    Args:\n        logits: Tensor of shape (batch_size, 4672)\n        masks: Tensor of shape (batch_size, 4672) where 1 is legal, 0 is illegal\n    Return:\n        masked_logits: normalized logics after masking\n    \"\"\"\n    mask_value = -1e9 \n    \n    masked_logits = logits.masked_fill(masks == 0, mask_value)\n    \n    return masked_logits","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-28T18:06:59.9339