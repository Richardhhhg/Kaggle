    "# Class for Chess Game, For converting outputs of Neural Networks into Moves\n",
    "class Game:\n",
    "    \"\"\"\n",
    "    Attributes:\n",
    "        model1: model to be trained\n",
    "        model2: model for opponent\n",
    "        board: The board\n",
    "        model1_colour: Colour of model1\n",
    "    \"\"\"\n",
    "    def __init__(self, model1, model2, model1_colour, debug=False):\n",
    "        self.model1 = model1\n",
    "        self.model2 = model2\n",
    "        self.board = chess.Board()\n",
    "        self.model1_colour = model1_colour\n",
    "        self.debug = debug\n",
    "    \n",
    "    def make_move(self):\n",
    "        move = None\n",
    "        board_tensor = board_to_tensor(self.board)\n",
    "        mask = get_legal_masks(self.board)\n",
    "        if self.debug:\n",
    "            print(f\"Current Turn: {self.board.turn}\")\n",
    "        if not self.model1_colour == self.board.turn:\n",
    "            move = self.model2(board_tensor)\n",
    "        else:\n",
    "            move = self.model1(board_tensor)\n",
    "        move = mask_illegal_moves(move, mask)\n",
    "        move_index = move.argmax()\n",
    "        move_uci = index_to_uci(move_index, self.board.turn)\n",
    "        move = chess.Move.from_uci(move_uci)\n",
    "        self.board.push(move)\n",
    "        if self.debug:\n",
    "            print(f\"Chosen Move: {move_uci}\")\n",
    "        return move_index, board_tensor"
