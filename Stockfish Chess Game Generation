    "def sample_top_moves(board, engine, k=K, depth=depth):\n",
    "    \"\"\"\n",
    "    params:\n",
    "        board: the board state, chess.Board object\n",
    "        engine: the engine playing, chess.engine.SimpleEngine\n",
    "        k: number of top moves to sample from, int\n",
    "        time: time given to engine to search for moves, float\n",
    "    returns:\n",
    "        move: chess.Move\n",
    "    \"\"\"\n",
    "    analysis = engine.analyse(board, chess.engine.Limit(depth=depth), multipv=k)\n",
    "    top_moves = [info[\"pv\"][0] for info in analysis if \"pv\" in info]\n",
    "    move = random.choice(top_moves)\n",
    "    return move\n",
    "\n",
    "def generate_game(engine):\n",
    "    \"\"\"\n",
    "    Generates game of chess with the engine playing itself.\n",
    "    params:\n",
    "        engine: Engine playing the game, chess.engine.SimpleEngine\n",
    "    returns:\n",
    "        game_pgn: pgn of game (only moves and result), str\n",
    "    \"\"\"\n",
    "    game = chess.pgn.Game()\n",
    "    board = chess.Board()\n",
    "    node = game\n",
    "    while not board.is_game_over():\n",
    "        move = sample_top_moves(board, engine)\n",
    "        board.push(move)\n",
    "        node = node.add_variation(move)\n",
    "\n",
    "    game.headers[\"Result\"] = board.result()\n",
    "    game_pgn = str(game)\n",
    "    start = game_pgn.find(\"1. \")\n",
    "    game_pgn = game_pgn[start:]\n",
    "    return game_pgn"
   ]
