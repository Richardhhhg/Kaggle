    "resblocks = 20\n",
    "CHANNELS = 256\n",
    "\n",
    "class ConvolutionBlock(nn.Module):\n",
    "    def __init__(self):\n",
    "        super(ConvolutionBlock, self).__init__()\n",
    "        self.conv1 = nn.Conv2d(12, CHANNELS, 3, stride=1, padding=1)\n",
    "        self.bn1 = nn.BatchNorm2d(CHANNELS)\n",
    "\n",
    "    def forward(self, x):\n",
    "        \"\"\"\n",
    "        Expects x of shape (batch_size, 12, 8, 8)\n",
    "        Returns tensor of shape (batch_size, CHANNELS, 8, 8)\n",
    "        \"\"\"\n",
    "        x = x.view(-1, 12, 8, 8) # batch x channel x rank x file, batch x 12 x 8 x 8\n",
    "        x = F.relu(self.bn1(self.conv1(x))) # batch x CHANNELS x 8 x 8\n",
    "        return x\n",
    "\n",
    "class OutputBlock(nn.Module):\n",
    "    def __init__(self):\n",
    "        super(OutputBlock, self).__init__()\n",
    "        self.conv1 = nn.Conv2d(CHANNELS, 1, 3, stride=1, padding=1)\n",
    "        self.bn1 = nn.BatchNorm2d(1)\n",
    "        self.fc1 = nn.Linear(64, 256)\n",
    "        self.fc2 = nn.Linear(256, 8*8*73)\n",
    "    \n",
    "    def forward(self, x):\n",
    "        \"\"\"\n",
    "        Expects x of shape (batch_size, CHANNELS, 8, 8)\n",
    "        Returns logits of shape (batch, 8*8*73) = (batch, 4672)\n",
    "        \"\"\"\n",
    "        x = F.relu(self.bn1(self.conv1(x))) # (batch, 8, 8)\n",
    "        x = x.view(-1, 64) # (batch, 64)\n",
    "        x = F.relu(self.fc1(x)) # (batch, 256)\n",
    "        logits = self.fc2(x) # (batch, 4672)\n",
    "        return logits\n",
    "\n",
    "class ResidualBlock(nn.Module):\n",
    "    def __init__(self):\n",
    "        super(ResidualBlock, self).__init__()\n",
    "        self.conv1 = nn.Conv2d(CHANNELS, CHANNELS, 3, stride=1, padding=1)\n",
    "        self.bn1 = nn.BatchNorm2d(CHANNELS)\n",
    "        self.conv2 = nn.Conv2d(CHANNELS, CHANNELS, 3, stride=1, padding=1)\n",
    "        self.bn2 = nn.BatchNorm2d(CHANNELS)\n",
    "    def forward(self, x):\n",
    "        \"\"\"\n",
    "        params:\n",
    "            x: Tensor of shape (batch_size, CHANNELS, 8, 8)\n",
    "        returns:\n",
    "            tensor of shape (batch_size, CHANNELS, 8, 8)\n",
    "        \"\"\"\n",
    "        residual = x\n",
    "        f_x = F.relu(self.bn1(self.conv1(x)))\n",
    "        f_x = self.bn2(self.conv2(f_x))\n",
    "        return F.relu(f_x + residual)\n",
    "\n",
    "class PolicyNN(nn.Module):\n",
