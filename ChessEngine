    "def encode_result(row):\n",
    "    if row[\"Colour\"] == chess.WHITE:\n",
    "        row[\"Result\"] = result_mapping[row[\"Result\"]]\n",
    "    else:\n",
    "        row[\"Result\"] = 1 - result_mapping[row[\"Result\"]]\n",
    "    return row\n",
    "\n",
    "board_df = board_df.progress_apply(encode_result, axis=1)"
