    "# Loading Lichess Data\n",
    "lichess_data = load_dataset(\n",
    "    \"Lichess/standard-chess-games\",\n",
    "    split=\"train\",\n",
    "    streaming=True,\n",
    "    columns=[\"WhiteElo\", \"BlackElo\", \"movetext\", \"Result\"]\n",
    ")\n",
    "def make_avg_elo(row):\n",
    "    if not row[\"WhiteElo\"] and not row[\"BlackElo\"]:\n",
    "        row[\"WhiteElo\"] = 0\n",
    "        row[\"BlackElo\"] = 0\n",
    "    elif not row[\"WhiteElo\"]:\n",
    "        row[\"WhiteElo\"] = row[\"BlackElo\"]\n",
    "    else:\n",
    "        row[\"BlackElo\"] = row[\"WhiteElo\"]\n",
    "    row[\"AverageElo\"] = (row[\"WhiteElo\"] + row[\"BlackElo\"]) / 2\n",
    "    return row\n",
    "    \n",
    "def elo_filter(row):\n",
    "    return row[\"AverageElo\"] >= ELO_CUTOFF\n",
    "\n",
    "lichess_data = lichess_data.map(make_avg_elo)\n",
    "lichess_data = lichess_data.remove_columns([\"WhiteElo\", \"BlackElo\"])\n",
    "lichess_data = lichess_data.take(NUM_GAMES)\n",
    "lichess_data = lichess_data.filter(elo_filter)\n",
    "lichess_data_list = []\n",
    "for row in tqdm(lichess_data):\n",
    "    if elo_filter(row):\n",
    "        lichess_data_list.append(row)\n",
    "lichess_data = pd.DataFrame(lichess_data)"
   ]
